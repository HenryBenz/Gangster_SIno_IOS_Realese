# Зависимости. На релизе ставятся через npm ci.
node_modules/

# Expo / Metro
.expo/
dist/
web-build/
expo-env.d.ts
.metro-health-check*

# Сборка и бандл
*.jsbundle
*.tsbuildinfo
coverage/

# Логи
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# macOS
.DS_Store

# Секреты и подпись. Сертификаты лежат в Codemagic, не в репозитории.
.env
.env.*
!.env.example
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.pem

# Xcode: локальное состояние, артефакты сборки, архивы
xcuserdata/
*.xcuserstate
*.xccheckout
*.moved-aside
DerivedData/
*.hmap
*.ipa
*.dSYM
*.dSYM.zip
**/.xcode.env.local

# CocoaPods. На релизе ставятся через pod install.
# ios/.gitignore уже закрывает Pods и build внутри ios/.
ios/Pods/
ios/build/
/vendor/bundle/

# Android, если когда-нибудь появится prebuild
android/.gradle/
android/build/
android/app/build/
local.properties
*.iml
.cxx/
.kotlin/

# Не нужно для сборки IPA: исходники уже собраны в assets/ и src/.
# Файлы остаются на диске, в репозиторий не попадают.
gangster-sino-images/
gangster_sino_icon.png
gangster-sino-technical-spec.md
tools/
